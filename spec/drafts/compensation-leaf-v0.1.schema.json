{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:draft:compensation-leaf:0.1",
  "title": "Mandatory compound inverse binding and held spend",
  "oneOf": [
    {
      "$ref": "#/$defs/binding"
    },
    {
      "$ref": "#/$defs/spend"
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "key_id",
        "payload",
        "signature"
      ],
      "properties": {
        "profile": {
          "const": "KF-COMPENSATION-LEAF-0.1-draft"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topology_digest",
            "contract_digest",
            "qualification_digest",
            "inverse_operation_key",
            "grant_digest",
            "certificate_digest",
            "parameters_digest",
            "forward",
            "compensation_units",
            "valid_from",
            "expires_at",
            "outcome_trust_digest"
          ],
          "properties": {
            "topology_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contract_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "qualification_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inverse_operation_key": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grant_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "certificate_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "parameters_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "forward": {
              "$ref": "#/$defs/forward"
            },
            "compensation_units": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "valid_from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expires_at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "outcome_trust_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "forward_operation_key",
        "inverse_operation_key",
        "grant_digest",
        "binding_digest",
        "compensation_units",
        "state",
        "attempt_id",
        "receipt_digest"
      ],
      "properties": {
        "profile": {
          "const": "KF-COMPENSATION-LEAF-0.1-draft"
        },
        "forward_operation_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inverse_operation_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compensation_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "allocated",
            "unknown",
            "committed",
            "proven_no_effect"
          ]
        },
        "attempt_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "forward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_digest",
        "root_id",
        "saga_id",
        "node_id",
        "operation_key",
        "grant_digest",
        "attempt_id",
        "receipt_digest",
        "resource"
      ],
      "properties": {
        "registration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "saga_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "incarnation"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "incarnation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
