{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:draft:outcome-recovery:0.1",
  "title": "DRAFT query-only recovery supplement; Receipt envelopes retain KF-JSON-0.2",
  "oneOf": [
    {
      "$ref": "#/$defs/Query"
    },
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/Transition"
    },
    {
      "$ref": "#/$defs/ExecutionRecord"
    },
    {
      "$ref": "#/$defs/ReceiptHead"
    }
  ],
  "$defs": {
    "Query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation",
        "attempt_id"
      ],
      "properties": {
        "profile": {
          "const": "KF-OUTCOME-RECOVERY-0.1-draft"
        },
        "operation": {
          "const": "query"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AttemptID",
        "RootID",
        "GrantDigest",
        "Status",
        "TargetReference"
      ],
      "properties": {
        "AttemptID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "RootID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "GrantDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "Status": {
          "enum": [
            "committed",
            "pending",
            "unknown",
            "not_found",
            "not_dispatched",
            "fenced_no_effect"
          ]
        },
        "TargetReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "attempt_id",
        "root_id",
        "grant_digest",
        "phase",
        "event_time"
      ],
      "properties": {
        "profile": {
          "const": "KF-OUTCOME-RECOVERY-0.1-draft"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase": {
          "enum": [
            "claimed",
            "dispatch_authorized",
            "committed",
            "not_dispatched",
            "unknown",
            "state_guard_violation"
          ]
        },
        "event_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ExecutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_grant",
        "tool",
        "parameters"
      ],
      "properties": {
        "signed_grant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "ReceiptHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_receipt",
        "receipt_digest",
        "state",
        "evidence_digest"
      ],
      "properties": {
        "signed_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "committed",
            "not_dispatched",
            "unknown",
            "state_guard_violation"
          ]
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
