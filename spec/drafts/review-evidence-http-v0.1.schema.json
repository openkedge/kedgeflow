{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kedgeflow.dev/spec/drafts/review-evidence-http-v0.1.schema.json",
  "$defs": {
    "ApprovalPayload": {
      "type": "object",
      "properties": {
        "proposal_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "reviewer": {
          "$ref": "#/$defs/SubjectIdentity"
        },
        "rendering_template_digest": {
          "$ref": "#/$defs/Digest"
        },
        "rendered_digest": {
          "$ref": "#/$defs/Digest"
        },
        "parameters_digest": {
          "$ref": "#/$defs/Digest"
        },
        "reviewed_at": {
          "$ref": "#/$defs/Time"
        },
        "expires_at": {
          "$ref": "#/$defs/Time"
        },
        "verdict": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "nonce": {
          "$ref": "#/$defs/Base64Url"
        },
        "rp_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "proposal_digest",
        "policy_epoch",
        "reviewer",
        "rendering_template_digest",
        "rendered_digest",
        "parameters_digest",
        "reviewed_at",
        "expires_at",
        "verdict",
        "nonce",
        "rp_id"
      ],
      "additionalProperties": false,
      "description": "Server constructs this exact payload. WebAuthn challenge is base64url(SHA256(JCS(payload))); authenticator signs authData plus SHA256(clientDataJSON), not this JSON directly."
    },
    "Base64Url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "HttpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/#?]+(?:/[^#]*)?$"
    },
    "SubjectIdentity": {
      "type": "object",
      "properties": {
        "iss": {
          "$ref": "#/$defs/HttpsUri"
        },
        "sub": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "iss",
        "sub"
      ],
      "additionalProperties": false,
      "description": "Human identity is the OIDC issuer/subject pair, never sub alone or an email display name."
    },
    "Time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "UTC milliseconds since Unix epoch; JSON safe integer."
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "const": "KF-REVIEW-EVIDENCE-HTTP-0.1-draft"
            },
            "operation": {
              "const": "challenge"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "credential_id": {
              "$ref": "#/$defs/Base64Url"
            },
            "challenge": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "approval": {
              "$ref": "#/$defs/ApprovalPayload"
            },
            "rendered": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          },
          "required": [
            "profile",
            "operation",
            "request_id",
            "credential_id",
            "challenge",
            "approval",
            "rendered"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "const": "KF-REVIEW-EVIDENCE-HTTP-0.1-draft"
            },
            "operation": {
              "const": "evidence"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "witness": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            }
          },
          "required": [
            "profile",
            "operation",
            "request_id",
            "witness"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "const": "KF-REVIEW-EVIDENCE-HTTP-0.1-draft"
            },
            "operation": {
              "const": "failure"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "code": {
              "enum": [
                "invalid_record",
                "unauthenticated",
                "forbidden",
                "authority_unavailable"
              ]
            }
          },
          "required": [
            "profile",
            "operation",
            "request_id",
            "code"
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "KF-REVIEW-EVIDENCE-HTTP-0.1-draft"
        },
        "operation": {
          "const": "begin"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "proposal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "credential_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "verdict": {
          "enum": [
            "approve",
            "reject"
          ]
        }
      },
      "required": [
        "profile",
        "operation",
        "request_id",
        "proposal",
        "descriptor",
        "credential_id",
        "verdict"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "KF-REVIEW-EVIDENCE-HTTP-0.1-draft"
        },
        "operation": {
          "const": "complete"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "proposal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "approval": {
          "$ref": "#/$defs/ApprovalPayload"
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credential_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "client_data_json": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "authenticator_data": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "signature": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "user_handle": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            }
          },
          "required": [
            "credential_id",
            "client_data_json",
            "authenticator_data",
            "signature",
            "user_handle"
          ]
        }
      },
      "required": [
        "profile",
        "operation",
        "request_id",
        "proposal",
        "descriptor",
        "approval",
        "assertion"
      ]
    }
  ]
}
