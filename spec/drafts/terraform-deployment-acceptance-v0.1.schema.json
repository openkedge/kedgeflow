      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "resource",
            "manifest_digest",
            "effect_digest",
            "guard_level",
            "target_atomic"
          ],
          "properties": {
            "profile": {
              "const": "KF-TERRAFORM-GATEWAY-0.1-draft"
            },
            "resource": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "incarnation"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^terraform:[a-f0-9]{64}$"
                },
                "incarnation": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,191}$"
                }
              }
            },
            "manifest_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "effect_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "guard_level": {
              "const": "Level_C"
            },
            "target_atomic": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "resource",
            "manifest_digest",
            "effect_digest",
            "guard_level",
            "target_atomic"
          ],
          "properties": {
            "profile": {
              "const": "KF-TERRAFORM-PAIR-GATEWAY-0.1-draft"
            },
