                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "manifest_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "effect_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "guard_level": {
              "const": "Level_C"
            },
            "target_atomic": {
              "const": false
            }
          }
        }
