{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kedgeflow.dev/spec/drafts/terraform-deployment-acceptance-v0.1.schema.json",
  "description": "Offline administrative owner-evidence records only. Semantic trust, signature, current-time, sequence, evidence and separation checks are mandatory; never execution authority or production certification. Pending requests are deliberately not valid accepted records.",
  "oneOf": [
    {
      "$ref": "#/$defs/Deployment"
    },
    {
      "$ref": "#/$defs/Trust"
    },
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/Evidence"
    },
    {
      "$ref": "#/$defs/Approval"
    },
    {
      "$ref": "#/$defs/Approvals"
    }
