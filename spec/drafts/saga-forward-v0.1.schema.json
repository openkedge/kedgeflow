{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:saga-forward:0.1-draft",
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "workload_id"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iss",
            "sub"
          ],
          "properties": {
            "iss": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sub": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "sagaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saga_id",
        "node_id",
        "plan_digest"
      ],
      "properties": {
        "saga_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "saga_id",
        "valid_from",
        "expires_at",
        "nodes",
        "outcome_keys",
        "source_id"
      ],
      "properties": {
        "profile": {
          "const": "KF-SAGA-FORWARD-0.1-draft"
        },
        "saga_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "valid_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "operation_key",
              "principal",
              "depends_on"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "operation_key": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "principal": {
                "$ref": "#/$defs/principal"
              },
              "depends_on": {
                "type": "array",
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        },
        "outcome_keys": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "kind",
        "key_id",
        "payload",
        "signature"
      ],
      "properties": {
        "profile": {
          "const": "KF-SAGA-FORWARD-0.1-draft"
        },
        "kind": {
          "const": "reservation_binding"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant",
            "conflict_domain",
            "root_id",
            "root_generation",
            "registration_digest",
            "operation_key",
            "grant_digest",
            "certificate_digest",
            "allocation_digest",
            "parent_grant_digest",
            "saga"
          ],
          "properties": {
            "tenant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "conflict_domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "root_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "root_generation": {
              "const": 1
            },
            "registration_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "operation_key": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grant_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "certificate_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "allocation_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "parent_grant_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "saga": {
              "$ref": "#/$defs/sagaBinding"
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
