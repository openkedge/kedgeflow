{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:draft:shared-authentication:0.1",
  "title": "DRAFT protected shared DPoP replay state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "registration_digest",
    "last_seen",
    "entries"
  ],
  "properties": {
    "profile": {
      "const": "KF-SHARED-AUTH-0.1-draft"
    },
    "registration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "last_seen": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740
    },
    "entries": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "pattern": "^[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740
      }
    }
  }
}
