{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kedgeflow.dev/spec/drafts/terraform-apply-v0.1.schema.json",
  "description": "Protected local original-attempt request and retained intent/report; not a portable signed outcome or general network API.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Intent"
    },
    {
      "$ref": "#/$defs/Report"
    }
  ],
  "$defs": {
    "Parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "expected_version",
        "manifest_digest",
        "effect_digest"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "const": 1
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effect_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "signed_grant",
        "attempt_id",
        "parameters",
        "target_credential"
      ],
      "properties": {
        "profile": {
          "const": "KF-TERRAFORM-APPLY-0.1-draft"
        },
        "signed_grant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "target_credential": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "manifest_digest",
        "effect_digest",
        "grant_digest",
        "root_id",
        "attempt_id",
        "state",
        "initiated_at",
        "backend_before_sha256",
        "backend_after_sha256",
        "observed_after_digest",
        "last_error"
      ],
      "properties": {
        "profile": {
          "const": "KF-TERRAFORM-APPLY-0.1-draft"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effect_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "started",
            "unknown",
            "applied"
          ]
        },
        "initiated_at": {
          "type": "integer"
        },
        "backend_before_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backend_after_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_after_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "intent",
        "replayed",
        "observed_postcondition"
      ],
      "properties": {
        "profile": {
          "const": "KF-TERRAFORM-APPLY-0.1-draft"
        },
        "status": {
          "enum": [
            "committed",
            "unknown"
          ]
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "replayed": {
          "type": "boolean"
        },
        "observed_postcondition": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
