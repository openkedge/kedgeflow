{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:draft:saga-observation:0.1",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/head"
    }
  ],
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "saga_id",
        "registration_digest",
        "nodes"
      ],
      "properties": {
        "profile": {
          "const": "KF-SAGA-OBSERVATION-0.1-draft"
        },
        "saga_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "registration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "operation_key",
              "principal",
              "depends_on",
              "inverse"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "operation_key": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "principal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "workload_id"
                ],
                "properties": {
                  "subject": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "iss",
                      "sub"
                    ],
                    "properties": {
                      "iss": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "sub": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  },
                  "workload_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              "depends_on": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                }
              },
              "inverse": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "scope",
                      "semantics_digest",
                      "applicability_digest",
                      "late_effect_barrier_digest",
                      "compensation_units"
                    ],
                    "properties": {
                      "scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "conflict_domain",
                          "action",
                          "resource",
                          "audience",
                          "adapter_contract",
                          "predicate_descriptor"
                        ],
                        "properties": {
                          "conflict_domain": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "action": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "version",
                              "digest"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              },
                              "version": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              },
                              "digest": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            }
                          },
                          "resource": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "incarnation"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              },
                              "incarnation": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              }
                            }
                          },
                          "audience": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048
                          },
                          "adapter_contract": {
                            "type": "object",
                            "maxProperties": 32
                          },
                          "predicate_descriptor": {
                            "type": "object",
                            "maxProperties": 32
                          }
                        }
                      },
                      "semantics_digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "applicability_digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "late_effect_barrier_digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "compensation_units": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "plan_digest",
        "revision",
        "compensation_requested",
        "budget_active",
        "status",
        "nodes",
        "execution_authority",
        "dependency_order_enforced"
      ],
      "properties": {
        "profile": {
          "const": "KF-SAGA-OBSERVATION-0.1-draft"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "compensation_requested": {
          "type": "boolean"
        },
        "budget_active": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "unresolved",
            "completed",
            "needs_operator"
          ]
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "forward",
              "grant_digest",
              "attempt_id",
              "receipt_digest",
              "proof_digest",
              "compensation",
              "unmet_dependencies",
              "dependency_violation"
            ],
            "properties": {
              "forward": {
                "enum": [
                  "planned",
                  "issued",
                  "unknown",
                  "committed",
                  "proven_no_effect",
                  "failed"
                ]
              },
              "grant_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "attempt_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "receipt_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "proof_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "compensation": {
                "enum": [
                  "unregistered",
                  "not_requested",
                  "blocked_forward_unknown",
                  "blocked_not_committed",
                  "requires_fresh_admission_and_barrier"
                ]
              },
              "unmet_dependencies": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                }
              },
              "dependency_violation": {
                "type": "boolean"
              }
            }
          }
        },
        "execution_authority": {
          "const": false
        },
        "dependency_order_enforced": {
          "const": false
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "plan_digest",
        "revision",
        "previous_digest",
        "phase",
        "after"
      ],
      "properties": {
        "profile": {
          "const": "KF-SAGA-OBSERVATION-0.1-draft"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "previous_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "enroll",
            "reconcile",
            "request_compensation"
          ]
        },
        "after": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "revision",
        "event_digest",
        "state_digest"
      ],
      "properties": {
        "profile": {
          "const": "KF-SAGA-OBSERVATION-0.1-draft"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "event_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
