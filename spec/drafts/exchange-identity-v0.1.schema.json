{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:draft:exchange-identity:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "KF-PINNED-EXCHANGE-IDENTITY-0.1-draft"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "not_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "subject_audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "actor_audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "subject_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "not_before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kid",
          "public_key",
          "not_before",
          "expires_at"
        ]
      }
    },
    "actor_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "trust_domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "alg": {
            "const": "ES256"
          },
          "use": {
            "const": "jwt-svid"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{87}$"
          },
          "not_before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kid",
          "trust_domain",
          "alg",
          "use",
          "public_key",
          "not_before",
          "expires_at"
        ]
      }
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "iss": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "sub": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "iss",
              "sub"
            ]
          },
          "workload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "allowed_scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "subject",
          "workload_id",
          "allowed_scopes"
        ]
      }
    },
    "withdrawn_subject_tokens": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "profile",
    "epoch",
    "not_before",
    "expires_at",
    "issuer",
    "subject_audience",
    "actor_audience",
    "subject_keys",
    "actor_keys",
    "registrations",
    "withdrawn_subject_tokens"
  ],
  "title": "DRAFT protected exchange identity trust snapshot"
}
