{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:hierarchical-leaf:0.1-draft",
  "oneOf": [
    {
      "$ref": "#/$defs/config"
    },
    {
      "$ref": "#/$defs/composite"
    },
    {
      "$ref": "#/$defs/binding"
    }
  ],
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "workload_id"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iss",
            "sub"
          ],
          "properties": {
            "iss": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sub": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "resources"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "description": "Signed composite scope arrays contain unique strings in ascending UTF-8 byte order; receivers reject reordered arrays before set decoding."
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "epoch",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "compositePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "conflict_domain",
        "root_id",
        "root_generation",
        "parent_grant_digest",
        "policy",
        "ownership_epoch",
        "leaf_scope_digest",
        "scope",
        "principals",
        "forward",
        "compensation",
        "valid_from",
        "expires_at",
        "execution_authority"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conflict_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "root_generation": {
          "const": 1
        },
        "parent_grant_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "ownership_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaf_scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "principals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/principal"
          }
        },
        "forward": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "compensation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "valid_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execution_authority": {
          "const": false
        }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "kind",
        "key_id",
        "payload",
        "signature"
      ],
      "properties": {
        "profile": {
          "const": "KF-COMPOSITE-GRANT-0.1-draft"
        },
        "kind": {
          "const": "composite_grant"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "$ref": "#/$defs/compositePayload"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "parent_grant_digest"
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "parent_grant_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_keys",
        "grants",
        "assignments"
      ],
      "properties": {
        "delegation_keys": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/composite"
          }
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "kind",
        "key_id",
        "payload",
        "signature"
      ],
      "properties": {
        "profile": {
          "const": "KF-HIERARCHICAL-LEAF-0.1-draft"
        },
        "kind": {
          "const": "reservation_binding"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant",
            "conflict_domain",
            "root_id",
            "root_generation",
            "registration_digest",
            "operation_key",
            "grant_digest",
            "certificate_digest",
            "allocation_digest",
            "parent_grant_digest"
          ],
          "properties": {
            "tenant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "conflict_domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "root_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "root_generation": {
              "const": 1
            },
            "registration_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "operation_key": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grant_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "certificate_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "allocation_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "parent_grant_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
