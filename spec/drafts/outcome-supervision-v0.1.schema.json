{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kedgeflow:draft:outcome-supervision:0.1",
  "title": "DRAFT protected unknown incidents and collector delivery progress",
  "oneOf": [
    {
      "$ref": "#/$defs/Incident"
    },
    {
      "$ref": "#/$defs/DeliveryProgress"
    }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "incident_id",
        "tenant",
        "grant_digest",
        "root_id",
        "attempt_id",
        "owner_id",
        "policy_digest",
        "unknown_since",
        "deadline",
        "revision",
        "state",
        "updated_at",
        "receipt_digest",
        "previous_digest"
      ],
      "properties": {
        "profile": {
          "const": "KF-OUTCOME-SUPERVISION-0.1-draft"
        },
        "incident_id": {
          "$ref": "#/$defs/Digest"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "grant_digest": {
          "$ref": "#/$defs/Digest"
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "unknown_since": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "state": {
          "enum": [
            "open",
            "escalated",
            "resolved"
          ]
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receipt_digest": {
          "$ref": "#/$defs/Digest"
        },
        "previous_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Digest"
            }
          ]
        }
      }
    },
    "DeliveryProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "collector_digest",
        "receipt_digest",
        "acknowledgement",
        "recorded_at"
      ],
      "properties": {
        "profile": {
          "const": "KF-OUTCOME-SUPERVISION-0.1-draft"
        },
        "collector_digest": {
          "$ref": "#/$defs/Digest"
        },
        "receipt_digest": {
          "$ref": "#/$defs/Digest"
        },
        "acknowledgement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
