+pass(() => validateTerraformArguments(d, args, r));
+for (const key of ['profile', 'manifestDigest', 'effectDigest', 'inspectionSha256']) { const bad = copy(r); bad[key] = 'other'; refuse(() => validateTerraformDescriptor(d, bad)); }
