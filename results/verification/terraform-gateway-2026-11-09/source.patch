+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "effect_digest": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "inspection_sha256": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        }
+      }
+    },
+    "ClientRegistration": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "profile",
+        "manifestDigest",
+        "effectDigest",
+        "inspectionSha256",
+        "resource"
+      ],
+      "properties": {
+        "profile": {
+          "const": "KF-TERRAFORM-GATEWAY-0.1-draft"
+        },
+        "manifestDigest": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "effectDigest": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        },
+        "inspectionSha256": {
+          "type": "string",
