+        "platform",
+        "workspace_id",
+        "backend",
+        "target",
+        "before_revision",
+        "after_revision",
+        "files"
+      ],
+      "properties": {
+        "profile": {
+          "const": "KF-TERRAFORM-PLAN-0.1-draft"
+        },
+        "terraform_version": {
+          "const": "1.17.1"
+        },
+        "provider_version": {
+          "const": "2.38.0"
+        },
+        "platform": {
+          "enum": [
+            "darwin_arm64",
+            "darwin_amd64",
+            "linux_arm64",
