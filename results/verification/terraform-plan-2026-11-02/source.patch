+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "kubernetes.bin": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "plan.bin": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "state.json": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "lock.hcl": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "configuration.json": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        }
+      }
+    },
+    "Manifest": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
