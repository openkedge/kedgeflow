+//! Named, one-plan native execution. Authority intent is durable before any
+//! writer credential is read or Terraform apply starts. Unknown never retries.
+use crate::{
+    contracts::{Resource, canonical, digest},
+    error::{Error, Result},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::path::PathBuf;
+
+pub const PROFILE: &str = "KF-TERRAFORM-APPLY-0.1-draft";
+pub const ACTION: &str = "terraform.configmap.annotation.apply";
+fn backend_advanced(before: &Value, after: &Value) -> bool {
+    // A single apply can persist multiple checkpoints (the real fixture moves
+    // serial 1 to 3). Serial counts state writes, not execution attempts.
+    before["lineage"].as_str().is_some_and(|s| !s.is_empty())
+        && before["lineage"] == after["lineage"]
+        && before["serial"]
+            .as_u64()
+            .zip(after["serial"].as_u64())
+            .is_some_and(|(a, b)| a < b && b <= crate::contracts::MAX_SAFE_INTEGER)
+}
+pub fn coverage() -> Value {
+    let mut inventory = json!({"coordinated_writers":["protected-terraform-runner"],"uncoordinated_writers":["privileged-administrators","kubernetes-control-plane"]});
+    inventory["inventory_digest"] =
+        json!(digest("coverage-inventory", &inventory).expect("fixed inventory"));
+    inventory
+}
+fn refused() -> Error {
+    Error::Refused("Terraform original plan/authority binding refused".into())
+}
+pub fn adapter_contract() -> Value {
+    json!({"level":"Level_C","guard_primitive":"None","fence_parameter":null,"guard_scope":[],
+        "completion_mode":"dispatch_bound","commit_point":"KF-TERRAFORM-APPLY-0.1-draft:original-native-intent-before-apply",
+        "idempotency":{"mode":"resource_key","parameter":"attempt_id","retention_ms":86400000}})
+}
+pub fn validate_adapter(version: &str, value: &Value, fence: Option<&str>) -> Result<()> {
+    if version != "1.0" || value != &adapter_contract() || fence.is_some_and(|s| !s.is_empty()) {
+        return Err(refused());
+    }
+    Ok(())
+}
+pub fn parameter_schema(manifest: &str, effect: &str, resource: &str) -> Result<Value> {
+    if !crate::grant_reference::valid_reference(manifest)
+        || !crate::grant_reference::valid_reference(effect)
+        || resource.is_empty()
+    {
+        return Err(refused());
+    }
+    Ok(
+        json!({"type":"object","additionalProperties":false,"required":["node","expected_version","manifest_digest","effect_digest"],
+        "properties":{"node":{"type":"string","const":resource},"expected_version":{"type":"integer","const":1},
+        "manifest_digest":{"type":"string","const":manifest},"effect_digest":{"type":"string","const":effect}}}),
+    )
+}
+pub fn validate_schema(version: &str, schema: &Value) -> Result<()> {
+    if version != "1.0"
+        || canonical(schema)?
+            != canonical(&parameter_schema(
+                schema["properties"]["manifest_digest"]["const"]
+                    .as_str()
+                    .ok_or_else(refused)?,
+                schema["properties"]["effect_digest"]["const"]
+                    .as_str()
+                    .ok_or_else(refused)?,
+                schema["properties"]["node"]["const"]
+                    .as_str()
+                    .ok_or_else(refused)?,
+            )?)?
+    {
+        return Err(refused());
+    }
+    Ok(())
+}
+pub fn bind(version: &str, p: &Value, r: &Resource, version_field: &str) -> Result<u64> {
+    if version != "1.0"
+        || version_field != "expected_version"
+        || p["node"] != r.id
+        || p["expected_version"] != 1
+        || p != &json!({"node":r.id,"expected_version":1,"manifest_digest":p["manifest_digest"],"effect_digest":p["effect_digest"]})
+        || !p["manifest_digest"]
+            .as_str()
+            .is_some_and(crate::grant_reference::valid_reference)
+        || !p["effect_digest"]
+            .as_str()
+            .is_some_and(crate::grant_reference::valid_reference)
+    {
+        return Err(refused());
+    }
+    Ok(1)
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Pins {
+    pub profile: String,
+    pub material_root: PathBuf,
+    pub manifest_file: PathBuf,
+    pub backend_root: PathBuf,
+    pub secret_root: PathBuf,
+    pub writer_token_file: PathBuf,
+    pub observer_token_file: PathBuf,
+    pub manifest_digest: String,
+    pub inspection_sha256: String,
+    pub effect_digest: String,
+    pub tool: crate::gateway::ToolDescriptor,
+    pub parameter_schema: Value,
+    pub gateway_workload: String,
+    pub target_audience: String,
+    pub target_scope: String,
+}
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub profile: String,
+    pub signed_grant: String,
+    pub attempt_id: String,
+    pub parameters: Value,
+    pub target_credential: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Intent {
+    pub profile: String,
+    pub manifest_digest: String,
+    pub effect_digest: String,
+    pub grant_digest: String,
+    pub root_id: String,
+    pub attempt_id: String,
+    pub state: String,
+    pub initiated_at: i64,
+    pub backend_before_sha256: String,
+    pub backend_after_sha256: Option<String>,
+    pub observed_after_digest: Option<String>,
+    pub last_error: Option<String>,
+}
+#[derive(Debug, Serialize)]
+pub struct Report {
+    pub profile: &'static str,
+    pub status: &'static str,
+    pub intent: Intent,
+    pub replayed: bool,
+    pub observed_postcondition: Option<bool>,
+}
+
+#[cfg(unix)]
+mod native {
+    use super::*;
+    use crate::{
+        clock::Clock,
+        contracts::{Grant, GrantVerifier, strict_value},
+        file_custody::{Material, Root},
+        ledger::{
+            AuthorityLedger, EtcdLedger, expected_root, get, put, range_kv, record, value_eq,
+            version_zero,
+        },
+        recovery::{Candidate, context_key},
+        target_token::{TargetTokenVerifier, TokenBinding},
+        terraform_plan::{EXECUTION_PROFILE, Prepared, prepare},
+    };
+    use sha2::{Digest, Sha256};
+    use std::{sync::Arc, time::Duration};
+    fn hash(v: &[u8]) -> String {
+        hex::encode(Sha256::digest(v))
+    }
+    pub struct Runner {
+        pins: Pins,
+        prepared: Prepared,
+        ledger: EtcdLedger,
+        grants: GrantVerifier,
+        tokens: TargetTokenVerifier,
+        clock: Arc<dyn Clock>,
+        secrets: Root,
+        backend: Root,
+        client: reqwest::Client,
+        url: reqwest::Url,
+    }
+    impl Runner {
+        pub async fn new(
+            pins: Pins,
+            ledger: EtcdLedger,
+            grants: GrantVerifier,
+            tokens: TargetTokenVerifier,
+            clock: Arc<dyn Clock>,
+        ) -> Result<Self> {
+            pins.tool.validate()?;
+            if pins.profile != PROFILE
+                || !ledger.require_control
+                || !crate::auth::valid_spiffe_id(&pins.gateway_workload)
+                || pins.target_scope != "terraform:apply"
+                || pins.target_audience.is_empty()
+                || pins.tool.action.as_ref().is_none_or(|a| a.id != ACTION)
+                || tokens.keys().any(|t| grants.keys.values().any(|g| g == t))
+            {
+                return Err(refused());
+            }
+            crate::endpoint::EndpointPolicy::new(&pins.target_audience)?;
+            let prepared = prepare(&pins.material_root, &pins.manifest_file).await?;
+            let i = &prepared.inspection;
+            let resource = pins.tool.resource.as_ref().ok_or_else(refused)?;
+            let schema =
+                parameter_schema(&pins.manifest_digest, &pins.effect_digest, &resource.id)?;
+            if prepared.manifest.profile != EXECUTION_PROFILE
+                || i.manifest_digest != pins.manifest_digest
+                || i.inspection_sha256 != pins.inspection_sha256
+                || i.effect_digest != pins.effect_digest
+                || resource.incarnation != prepared.manifest.target.uid
+                || pins.parameter_schema != schema
+                || pins.tool.adapter_contract != adapter_contract()
+            {
+                return Err(refused());
+            }
+            let backend = Root::open(&pins.backend_root)?;
+            let secrets = Root::open(&pins.secret_root)?;
+            let p = &prepared.config["provider"]["kubernetes"];
+            let origin = p["host"].as_str().ok_or_else(refused)?;
+            let url = reqwest::Url::parse(&format!(
+                "{}/api/v1/namespaces/{}/configmaps/{}",
+                origin.trim_end_matches('/'),
+                prepared.manifest.target.namespace,
+                prepared.manifest.target.name
+            ))
+            .map_err(|_| refused())?;
+            let ca = p["cluster_ca_certificate"].as_str().ok_or_else(refused)?;
+            let client = reqwest::Client::builder()
+                .no_proxy()
+                .tls_built_in_root_certs(false)
+                .add_root_certificate(
+                    reqwest::Certificate::from_pem(ca.as_bytes()).map_err(|_| refused())?,
+                )
+                .redirect(reqwest::redirect::Policy::none())
+                .timeout(Duration::from_secs(3))
+                .build()?;
+            // Validate the registered path and snapshot custody; later reads may
+            // legitimately see a changed backend after the original attempt.
+            let path = prepared
+                .manifest
+                .backend_state_path
+                .as_ref()
+                .ok_or_else(refused)?;
+            backend.read(std::path::Path::new(path), Material::Secret, 2 << 20)?;
+            Ok(Self {
+                pins,
+                prepared,
+                ledger,
+                grants,
+                tokens,
+                clock,
+                secrets,
+                backend,
+                client,
+                url,
+            })
+        }
+        fn key(&self) -> String {
+            format!(
+                "{}/terraform/{}/intent",
+                self.ledger.namespace(),
+                self.pins.manifest_digest
+            )
+        }
+        fn credential(&self, path: &std::path::Path) -> Result<String> {
+            let value = String::from_utf8(self.secrets.read(path, Material::Secret, 16 << 10)?)
+                .map_err(|_| refused())?;
+            let value = value.trim();
+            if value.is_empty() || value.bytes().any(|b| b <= b' ' || b == 127) {
+                return Err(refused());
+            }
+            Ok(value.into())
+        }
+        fn backend_bytes(&self) -> Result<Vec<u8>> {
+            self.backend.read(
+                std::path::Path::new(self.prepared.manifest.backend_state_path.as_ref().unwrap()),
+                Material::Secret,
+                2 << 20,
+            )
+        }
+        async fn observe(&self) -> Result<Value> {
+            let token = self.credential(&self.pins.observer_token_file)?;
+            let response = self
+                .client
+                .get(self.url.clone())
+                .bearer_auth(token)
+                .send()
+                .await?;
+            if !response.status().is_success() || response.url() != &self.url {
+                return Err(refused());
+            }
+            let raw = crate::grant_reference::bounded_response(response, 2 << 20).await?;
+            strict_value(&raw)
+        }
+        fn target_matches(&self, v: &Value, post: bool) -> bool {
+            let m = &self.prepared.manifest;
+            let before = &self.prepared.state["resources"][0]["instances"][0]["attributes"];
+            let mut annotations = before["metadata"][0]["annotations"].clone();
+            if post {
+                annotations[crate::terraform_plan::ANNOTATION] = json!(m.after_revision);
+            }
+            let empty = json!({});
+            v["metadata"]["uid"] == m.target.uid
+                && v["metadata"]["name"] == m.target.name
+                && v["metadata"]["namespace"] == m.target.namespace
+                && (post || v["metadata"]["resourceVersion"] == m.target.resource_version)
+                && v["metadata"].get("annotations").unwrap_or(&empty) == &annotations
+                && v["metadata"].get("labels").unwrap_or(&empty) == &before["metadata"][0]["labels"]
+                && v.get("data").unwrap_or(&empty) == &before["data"]
+                && v.get("binaryData").unwrap_or(&empty) == &before["binary_data"]
+                && v.get("immutable").unwrap_or(&json!(false)) == &before["immutable"]
+        }
+        async fn retained(&self) -> Result<Option<Intent>> {
+            let t = self
+                .ledger
+                .txn(vec![], vec![get(&self.key())], vec![])
+                .await?;
+            if !t.succeeded || t.responses.len() != 1 {
+                return Err(refused());
+            }
+            let Some(kv) = range_kv(&t.responses[0])? else {
+                return Ok(None);
+            };
+            if kv.value.len() > 16384 {
+                return Err(refused());
+            }
+            let i: Intent =
+                serde_json::from_value(strict_value(&kv.value)?).map_err(|_| refused())?;
+            if i.profile != PROFILE
+                || i.manifest_digest != self.pins.manifest_digest
+                || i.effect_digest != self.pins.effect_digest
+                || !["started", "unknown", "applied"].contains(&i.state.as_str())
+                || !crate::grant_reference::valid_reference(&i.grant_digest)
+                || !crate::grant_reference::valid_reference(&i.backend_before_sha256)
+                || i.root_id.is_empty()
+                || i.attempt_id.is_empty()
+                || i.attempt_id.len() > 1024
+                || i.initiated_at < 0
+                || i.last_error
+                    .as_ref()
+                    .is_some_and(|e| e.chars().count() > 256)
+                || if i.state == "applied" {
+                    i.last_error.is_some()
+                        || !i
+                            .backend_after_sha256
+                            .as_deref()
+                            .is_some_and(crate::grant_reference::valid_reference)
+                        || !i
+                            .observed_after_digest
+                            .as_deref()
+                            .is_some_and(crate::grant_reference::valid_reference)
+                } else {
+                    i.backend_after_sha256.is_some()
+                        || i.observed_after_digest.is_some()
+                        || (i.state == "started" && i.last_error.is_some())
+                }
+            {
+                return Err(refused());
+            }
+            Ok(Some(i))
+        }
+        pub async fn status(&self, attempt: &str) -> Result<Report> {
+            let intent = self
+                .retained()
+                .await?
+                .filter(|i| i.attempt_id == attempt)
+                .ok_or_else(refused)?;
+            let observed = self
+                .observe()
+                .await
+                .ok()
+                .map(|v| self.target_matches(&v, true));
+            Ok(Report {
+                profile: PROFILE,
+                status: if intent.state == "applied" {
+                    "committed"
+                } else {
+                    "unknown"
+                },
+                intent,
+                replayed: true,
+                observed_postcondition: observed,
+            })
+        }
+        fn bind_grant(&self, g: &Grant, parameters: &Value) -> Result<()> {
+            if self.pins.tool.action.as_ref() != Some(&g.action)
+                || self.pins.tool.resource.as_ref() != g.resources.first()
+                || g.adapter_contract != adapter_contract()
+                || g.conflict_domain != self.pins.tool.conflict_domain
+                || digest("parameters", parameters)? != g.parameters_digest
+                || parameters
+                    != &json!({"node":g.resources[0].id,"expected_version":1,"manifest_digest":self.pins.manifest_digest,"effect_digest":self.pins.effect_digest})
+                || g.predicate_descriptor
+                    != json!({"id":self.pins.tool.predicate_id,"version":self.pins.tool.predicate_version,"language":"kf-conjunction-v1","clauses":[{"kind":"version_eq","resource":g.resources[0],"expected_version":"1"}]})
+            {
+                return Err(refused());
+            }
+            Ok(())
+        }
+        pub async fn execute(&self, r: &Request) -> Result<Report> {
+            if r.profile != PROFILE
+                || r.signed_grant.len() > 1 << 20
+                || r.attempt_id.is_empty()
+                || r.attempt_id.len() > 1024
+            {
+                return Err(refused());
+            }
+            let verified = self.grants.verify_retained(r.signed_grant.as_bytes())?;
+            let g = &verified.grant;
+            self.bind_grant(g, &r.parameters)?;
+            if let Some(i) = self.retained().await? {
+                if i.attempt_id != r.attempt_id
+                    || i.grant_digest != verified.digest
+                    || i.root_id != g.root_id
+                {
+                    return Err(refused());
+                }
+                return self.status(&r.attempt_id).await;
+            }
+            let now = self.clock.now_ms();
+            self.grants.verify(r.signed_grant.as_bytes(), now)?;
+            let claims = self.tokens.verify(
+                &r.target_credential,
+                &TokenBinding {
+                    grant_digest: verified.digest.clone(),
+                    root_id: g.root_id.clone(),
+                    attempt_id: r.attempt_id.clone(),
+                    gateway_workload: self.pins.gateway_workload.clone(),
+                    audience: self.pins.target_audience.clone(),
+                    scope: self.pins.target_scope.clone(),
+                    max_expires_at: g.expires_at,
+                },
+                now,
+            )?;
+            let candidate = Candidate {
+                grant: g.clone(),
+                attempt_id: r.attempt_id.clone(),
+            };
+            let snapshot = self.ledger.recovery_snapshot(&candidate).await?;
+            snapshot.context.validate(g, &verified.digest)?;
+            if snapshot.attempt.status != "claimed"
+                || snapshot.outbox != "dispatch_authorized"
+                || snapshot.context.signed_grant != r.signed_grant
+                || snapshot.context.parameters != r.parameters
+                || snapshot.context.tool != self.pins.tool.name
+            {
+                return Err(refused());
+            }
+            let permit_key = format!(
+                "{}/credential-permit",
+                self.ledger.attempt(g, &r.attempt_id)
+            );
+            let permit_bytes = self
+                .ledger
+                .read_key(&permit_key)
+                .await?
+                .ok_or_else(refused)?;
+            let permit = String::from_utf8(permit_bytes).map_err(|_| refused())?;
+            let p: crate::broker_authorization::ExchangePermit =
+                serde_json::from_value(strict_value(permit.as_bytes())?).map_err(|_| refused())?;
+            crate::broker_authorization::validate_permit(&json!(p))?;
+            if p.permit_id != claims.permit_id
+                || p.attempt_id != r.attempt_id
+                || p.grant_digest != verified.digest
+                || p.root_id != g.root_id
+                || p.gateway_workload != self.pins.gateway_workload
+                || p.target_audience != self.pins.target_audience
+                || p.target_scope != self.pins.target_scope
+            {
+                return Err(refused());
+            }
+            let before = self.backend_bytes()?;
+            if hash(&before) != self.prepared.inspection.inputs["state.json"]
+                || !self.target_matches(&self.observe().await?, false)
+            {
+                return Err(refused());
+            }
+            let mut root = expected_root(g);
+            root.status = "claimed".into();
+            let mut compare = vec![
+                value_eq(&self.ledger.root(g), &record(&root)?),
+                value_eq(&self.ledger.grant_key(g), &verified.digest),
+                value_eq(&self.ledger.nonce(g), &r.attempt_id),
+                value_eq(
+                    &self.ledger.attempt(g, &r.attempt_id),
+                    &record(&snapshot.attempt)?,
+                ),
+                value_eq(&self.ledger.outbox(g, &r.attempt_id), "dispatch_authorized"),
+                value_eq(
+                    &context_key(&self.ledger, g, &r.attempt_id),
+                    &snapshot.context_raw,
+                ),
+                value_eq(
+                    &format!("{}/policy", self.ledger.domain(g)),
+                    &record(&g.policy)?,
+                ),
+                value_eq(
+                    &format!("{}/ownership", self.ledger.domain(g)),
+                    &g.ownership_epoch.to_string(),
+                ),
+                value_eq(&permit_key, &permit),
+                version_zero(&self.key()),
+            ];
+            compare.extend(self.ledger.grant_control_compare(g).await?);
+            let now = self.clock.now_ms();
+            self.grants.verify(r.signed_grant.as_bytes(), now)?;
+            self.tokens
+                .verify(&r.target_credential, &TokenBinding::from(&p), now)?;
+            let mut intent = Intent {
+                profile: PROFILE.into(),
+                manifest_digest: self.pins.manifest_digest.clone(),
+                effect_digest: self.pins.effect_digest.clone(),
+                grant_digest: verified.digest.clone(),
+                root_id: g.root_id.clone(),
+                attempt_id: r.attempt_id.clone(),
+                state: "started".into(),
+                initiated_at: now,
+                backend_before_sha256: hash(&before),
+                backend_after_sha256: None,
+                observed_after_digest: None,
+                last_error: None,
+            };
+            let original = record(&intent)?;
+            let written = self
+                .ledger
+                .txn(compare, vec![put(&self.key(), &original)], vec![])
+                .await?;
+            if !written.succeeded {
+                return Err(refused());
+            }
+            // No path after this durable one-shot intent may retry apply, even if
+            // credential access, spawn, native locking or reply delivery fails.
+            let applied = async {
+                let now = self.clock.now_ms();
+                self.grants.verify(r.signed_grant.as_bytes(), now)?;
+                self.tokens
+                    .verify(&r.target_credential, &TokenBinding::from(&p), now)?;
+                let token = self.credential(&self.pins.writer_token_file)?;
+                self.prepared
+                    .stage
+                    .command_with_token(
+                        &[
+                            "apply",
+                            "-input=false",
+                            "-lock=true",
+                            "-lock-timeout=1s",
+                            "-no-color",
+                            "plan.bin",
+                        ],
+                        Some(&token),
+                    )
+                    .await?;
+                let backend = self.backend_bytes()?;
+                let state = strict_value(&backend)?;
+                let observed = self.observe().await?;
+                if !backend_advanced(&self.prepared.state, &state) {
+                    return Err(Error::Refused(
+                        "Terraform backend lineage/serial transition refused".into(),
+                    ));
+                }
+                if !self.target_matches(&observed, true) {
+                    return Err(Error::Refused(
+                        "Terraform independent target postcondition refused".into(),
+                    ));
+                }
+                Ok::<_, Error>((
+                    hash(&backend),
+                    digest("terraform-target-observation", &observed)?,
+                ))
+            }
+            .await;
+            match applied {
+                Ok((backend, observation)) => {
+                    intent.state = "applied".into();
+                    intent.backend_after_sha256 = Some(backend);
+                    intent.observed_after_digest = Some(observation);
+                }
+                Err(error) => {
+                    intent.state = "unknown".into();
+                    intent.last_error = Some(error.to_string().chars().take(256).collect());
+                }
+            }
+            let recorded = self
+                .ledger
+                .txn(
+                    vec![value_eq(&self.key(), &original)],
+                    vec![put(&self.key(), &record(&intent)?)],
+                    vec![],
+                )
+                .await?;
+            if !recorded.succeeded {
+                return Err(Error::Unknown(
+                    "Terraform original outcome retention unavailable".into(),
+                ));
+            }
+            self.ledger
+                .finish_recorded(
+                    g,
+                    &snapshot.attempt,
+                    if intent.state == "applied" {
+                        "committed"
+                    } else {
+                        "unknown"
+                    },
+                    &json!({"kind":"terraform_original_intent","intent":intent}),
+                )
+                .await?;
+            let observed = self
+                .observe()
+                .await
+                .ok()
+                .map(|v| self.target_matches(&v, true));
+            Ok(Report {
+                profile: PROFILE,
+                status: if intent.state == "applied" {
+                    "committed"
+                } else {
+                    "unknown"
+                },
+                intent,
+                replayed: false,
+                observed_postcondition: observed,
+            })
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn backend_progress_allows_multiple_checkpoints_but_refuses_rollback_or_substitution() {
+        let before = json!({"lineage":"original","serial":1});
+        for serial in [2, 3] {
+            assert!(backend_advanced(
+                &before,
+                &json!({"lineage":"original","serial":serial})
+            ));
+        }
+        for after in [
+            json!({"lineage":"other","serial":3}),
+            json!({"lineage":"original","serial":0}),
+            json!({"lineage":"original","serial":1}),
+            json!({"lineage":"original","serial":"3"}),
+            json!({"lineage":"original","serial":crate::contracts::MAX_SAFE_INTEGER+1}),
+            json!({"serial":3}),
+        ] {
+            assert!(!backend_advanced(&before, &after));
+        }
+    }
+}
+#[cfg(unix)]
+pub use native::Runner;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LedgerConfig {
+    pub endpoint: String,
+    pub prefix: String,
+    pub ca: PathBuf,
+    pub certificate: PathBuf,
+    pub private_key: PathBuf,
+    pub token_file: PathBuf,
+    pub restore_gate: Option<crate::restore::RestoreGateConfig>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Config {
+    pub pins: Pins,
+    pub ledger: LedgerConfig,
+    pub gateway_audience: String,
+    pub grant_keys: std::collections::BTreeMap<String, String>,
+    pub token_issuer: String,
+    pub target_keys: std::collections::BTreeMap<String, String>,
+}
+#[cfg(unix)]
+impl Config {
+    pub async fn load(root: &std::path::Path, path: &std::path::Path) -> Result<Runner> {
+        use crate::{
+            clock::SystemClock,
+            contracts::{GrantVerifier, strict_value},
+            file_custody::Material,
+            ledger::EtcdLedger,
+            service_files::ServiceFiles,
+            target_token::TargetTokenVerifier,
+        };
+        let files = ServiceFiles::protected(root)?;
+        let c: Self = serde_json::from_value(strict_value(
+            &files.read(path, Material::Secret, 2 << 20).await?,
+        )?)?;
+        crate::grant_reference::fixed_https(&c.ledger.endpoint)?;
+        crate::managed_drain_files::local_role(
+            &files
+                .read(&c.ledger.certificate, Material::Public, 1 << 20)
+                .await?,
+            &c.pins.gateway_workload,
+        )?;
+        let client = files
+            .http_client(
+                &c.ledger.ca,
+                &c.ledger.certificate,
+                &c.ledger.private_key,
+                std::time::Duration::from_secs(5),
+            )
+            .await?;
+        let mut ledger = EtcdLedger::new(client, &c.ledger.endpoint, &c.ledger.prefix)?
+            .with_auth_token_file(&files, &c.ledger.token_file)
+            .await?
+            .requiring_control(None);
+        if let Some(gate) = c.ledger.restore_gate {
+            ledger = gate.attach_with_files(ledger, &files).await?;
+        }
+        Runner::new(
+            c.pins,
+            ledger,
+            GrantVerifier {
+                keys: crate::control_config::keys(&c.grant_keys)?,
+                audience: c.gateway_audience,
+            },
+            TargetTokenVerifier::new(c.token_issuer, crate::control_config::keys(&c.target_keys)?)?,
+            std::sync::Arc::new(SystemClock),
+        )
+        .await
+    }
+}
diff --git a/crates/kedgeflow/src/terraform_plan.rs b/crates/kedgeflow/src/terraform_plan.rs
new file mode 100644
index 0000000..7270d40
--- /dev/null
+++ b/crates/kedgeflow/src/terraform_plan.rs
@@ -0,0 +1,748 @@
+//! Protected, read-only saved-plan inspection. This module issues no authority
+//! and deliberately offers no apply command or ResourceAdapter implementation.
+use crate::{
+    contracts::{digest, strict_value},
+    error::{Error, Result},
+    file_custody::{Material, Root},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    path::{Path, PathBuf},
+    time::Duration,
+};
+
+pub const PROFILE: &str = "KF-TERRAFORM-PLAN-0.1-draft";
+pub const EXECUTION_PROFILE: &str = "KF-TERRAFORM-PLAN-0.2-draft";
+pub const ANNOTATION: &str = "kedgeflow.dev/revision";
+const ADDRESS: &str = "kubernetes_config_map_v1.target";
+const PROVIDER: &str = "registry.terraform.io/hashicorp/kubernetes";
+const FILES: [&str; 6] = [
+    "terraform.bin",
+    "kubernetes.bin",
+    "plan.bin",
+    "state.json",
+    "lock.hcl",
+    "configuration.json",
+];
+const MAX_JSON: usize = 2 << 20;
+fn refuse(reason: &str) -> Error {
+    Error::Refused(format!("Terraform plan: {reason}"))
+}
+fn require(condition: bool, reason: &str) -> Result<()> {
+    if condition {
+        Ok(())
+    } else {
+        Err(refuse(reason))
+    }
+}
+fn hash(bytes: &[u8]) -> String {
+    hex::encode(Sha256::digest(bytes))
+}
+fn identifier(s: &str) -> bool {
+    !s.is_empty()
+        && s.len() <= 253
+        && s.bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-_.:/".contains(&b))
+}
+fn closed(v: &Value, keys: &[&str]) -> bool {
+    v.as_object()
+        .is_some_and(|o| o.keys().all(|k| keys.contains(&k.as_str())))
+}
+fn empty(v: Option<&Value>) -> bool {
+    v.is_none_or(|v| {
+        v.as_object().is_some_and(|o| o.is_empty()) || v.as_array().is_some_and(|a| a.is_empty())
+    })
+}
+fn one(v: &Value) -> Result<&Value> {
+    let a = v
+        .as_array()
+        .ok_or_else(|| refuse("expected one resource"))?;
+    require(a.len() == 1, "expected one resource")?;
+    Ok(&a[0])
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Target {
+    pub cluster_uid: String,
+    pub namespace: String,
+    pub name: String,
+    pub uid: String,
+    pub resource_version: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub profile: String,
+    pub terraform_version: String,
+    pub provider_version: String,
+    pub platform: String,
+    pub workspace_id: String,
+    pub backend: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub backend_state_path: Option<String>,
+    pub target: Target,
+    pub before_revision: String,
+    pub after_revision: String,
+    pub files: BTreeMap<String, String>,
+}
+impl Manifest {
+    pub fn decode(raw: &[u8]) -> Result<Self> {
+        require(raw.len() <= 64 * 1024, "manifest size")?;
+        let value = strict_value(raw)?;
+        require(
+            value["profile"] != PROFILE || value.get("backend_state_path").is_none(),
+            "v0.1 backend override",
+        )?;
+        let result: Self = serde_json::from_value(value).map_err(|_| refuse("manifest shape"))?;
+        result.validate()?;
+        Ok(result)
+    }
+    fn validate(&self) -> Result<()> {
+        require(
+            (self.profile == PROFILE || self.profile == EXECUTION_PROFILE)
+                && self.terraform_version == "1.17.1"
+                && self.provider_version == "2.38.0",
+            "unsupported version",
+        )?;
+        require(
+            ["darwin_arm64", "darwin_amd64", "linux_arm64", "linux_amd64"]
+                .contains(&self.platform.as_str()),
+            "unsupported platform",
+        )?;
+        require(
+            self.backend == "local" && identifier(&self.workspace_id),
+            "workspace/backend",
+        )?;
+        match (&self.backend_state_path, self.profile.as_str()) {
+            (None, PROFILE) => (),
+            (Some(path), EXECUTION_PROFILE) => {
+                let p = Path::new(path);
+                require(
+                    p.is_absolute()
+                        && p.file_name().is_some_and(|s| s == "terraform.tfstate")
+                        && p.components().all(|c| {
+                            matches!(
+                                c,
+                                std::path::Component::RootDir | std::path::Component::Normal(_)
+                            )
+                        }),
+                    "explicit local backend path",
+                )?;
+            }
+            _ => return Err(refuse("backend profile binding")),
+        }
+        for id in [
+            &self.target.cluster_uid,
+            &self.target.namespace,
+            &self.target.name,
+            &self.target.uid,
+            &self.target.resource_version,
+        ] {
+            require(identifier(id), "target identity")?;
+        }
+        let dns = |value: &str| {
+            value.split('.').all(|label| {
+                !label.is_empty()
+                    && label.len() <= 63
+                    && label.as_bytes()[0].is_ascii_alphanumeric()
+                    && label.as_bytes()[label.len() - 1].is_ascii_alphanumeric()
+                    && label
+                        .bytes()
+                        .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+            })
+        };
+        require(
+            self.target.namespace.len() <= 63
+                && !self.target.namespace.contains('.')
+                && dns(&self.target.namespace)
+                && dns(&self.target.name),
+            "target DNS names",
+        )?;
+        require(
+            self.before_revision != self.after_revision
+                && [&self.before_revision, &self.after_revision]
+                    .iter()
+                    .all(|s| !s.is_empty() && s.len() <= 256),
+            "revision binding",
+        )?;
+        require(
+            self.files.len() == FILES.len() + usize::from(self.profile == EXECUTION_PROFILE)
+                && (self.profile != EXECUTION_PROFILE
+                    || self
+                        .files
+                        .get("backend.json")
+                        .is_some_and(|h| crate::grant_reference::valid_reference(h)))
+                && FILES.iter().all(|n| {
+                    self.files.get(*n).is_some_and(|h| {
+                        h.len() == 64
+                            && h.bytes()
+                                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                    })
+                }),
+            "exact file pins",
+        )
+    }
+}
+/// Candidate evidence only. Neither the digest nor `inspection_passed` is an
+/// admission certificate, a grant, current target evidence or permission to apply.
+#[derive(Debug, Serialize)]
+pub struct Inspection {
+    pub profile: String,
+    pub status: &'static str,
+    pub manifest_digest: String,
+    pub inspection_sha256: String,
+    pub inputs: BTreeMap<String, String>,
+    pub workspace_id: String,
+    pub backend: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub backend_state_path: Option<String>,
+    pub state_lineage: String,
+    pub state_serial: u64,
+    pub target: Target,
+    pub effect_digest: String,
+    pub guard_level: &'static str,
+    pub execution_enabled: bool,
+}
+
+fn configuration(m: &Manifest, value: &Value) -> Result<()> {
+    fn literal(v: &Value) -> bool {
+        match v {
+            Value::String(s) => !s.contains("${") && !s.contains("%{"),
+            Value::Array(a) => a.iter().all(literal),
+            Value::Object(o) => o.values().all(literal),
+            _ => true,
+        }
+    }
+    require(literal(value), "configuration expressions")?;
+    require(
+        closed(value, &["terraform", "provider", "resource"])
+            && value.as_object().is_some_and(|o| o.len() == 3),
+        "configuration root",
+    )?;
+    let mut terraform = json!({"required_providers":{"kubernetes":{"source":"hashicorp/kubernetes","version":"=2.38.0"}}});
+    if let Some(path) = &m.backend_state_path {
+        terraform["backend"] = json!({"local":{"path":path}});
+    }
+    require(
+        value["terraform"] == terraform,
+        "provider declaration or backend override",
+    )?;
+    let providers = &value["provider"];
+    require(
+        closed(providers, &["kubernetes"]) && providers.as_object().is_some_and(|o| o.len() == 1),
+        "provider configuration",
+    )?;
+    let p = &providers["kubernetes"];
+    let provider_fields = if m.profile == EXECUTION_PROFILE {
+        vec!["host", "cluster_ca_certificate"]
+    } else {
+        vec!["host", "cluster_ca_certificate", "token"]
+    };
+    require(
+        closed(p, &provider_fields)
+            && p.as_object()
+                .is_some_and(|o| o.len() == provider_fields.len()),
+        "provider credential source",
+    )?;
+    let url = p["host"]
+        .as_str()
+        .and_then(|s| reqwest::Url::parse(s).ok())
+        .ok_or_else(|| refuse("provider origin"))?;
+    require(
+        url.scheme() == "https"
+            && url.host_str().is_some()
+            && url.username().is_empty()
+            && url.password().is_none()
+            && url.query().is_none()
+            && url.fragment().is_none()
+            && url.path() == "/",
+        "provider origin",
+    )?;
+    for key in provider_fields.into_iter().filter(|s| *s != "host") {
+        require(
+            p[key].as_str().is_some_and(|s| !s.is_empty()),
+            "provider credential source",
+        )?;
+    }
+    let resources = &value["resource"];
+    require(
+        closed(resources, &["kubernetes_config_map_v1"])
+            && resources.as_object().is_some_and(|o| o.len() == 1),
+        "resource type",
+    )?;
+    let maps = &resources["kubernetes_config_map_v1"];
+    require(
+        closed(maps, &["target"]) && maps.as_object().is_some_and(|o| o.len() == 1),
+        "resource count",
+    )?;
+    let map = &maps["target"];
+    require(
+        closed(map, &["metadata", "data", "binary_data", "immutable"]),
+        "resource hooks or unsupported fields",
+    )?;
+    let metadata = &map["metadata"];
+    require(
+        closed(metadata, &["name", "namespace", "annotations", "labels"])
+            && metadata["name"] == m.target.name
+            && metadata["namespace"] == m.target.namespace
+            && metadata["annotations"][ANNOTATION] == m.after_revision,
+        "configured target/revision",
+    )?;
+    Ok(())
+}
+
+fn values(m: &Manifest, before: &Value, after: &Value, unknown: &Value) -> Result<()> {
+    require(
+        before.is_object() && after.is_object(),
+        "missing resource values",
+    )?;
+    let b = one(&before["metadata"])?;
+    let a = one(&after["metadata"])?;
+    require(
+        before["id"] == format!("{}/{}", m.target.namespace, m.target.name)
+            && after["id"] == before["id"],
+        "provider target identity",
+    )?;
+    require(
+        b["uid"] == m.target.uid
+            && b["resource_version"] == m.target.resource_version
+            && b["name"] == m.target.name
+            && b["namespace"] == m.target.namespace
+            && a["uid"] == m.target.uid
+            && a["name"] == m.target.name
+            && a["namespace"] == m.target.namespace
+            && b["annotations"][ANNOTATION] == m.before_revision
+            && a["annotations"][ANNOTATION] == m.after_revision,
+        "target state or revision",
+    )?;
+    // Only provider-computed generation/resource_version may become unknown.
+    let mut allowed_unknown = unknown.clone();
+    if let Some(meta) = allowed_unknown.get_mut("metadata") {
+        let rows = meta
+            .as_array_mut()
+            .ok_or_else(|| refuse("unknown metadata shape"))?;
+        require(rows.len() == 1, "unknown metadata count")?;
+        let row = rows[0]
+            .as_object_mut()
+            .ok_or_else(|| refuse("unknown metadata shape"))?;
+        row.remove("generation");
+        row.remove("resource_version");
+    }
+    fn known(v: &Value) -> bool {
+        match v {
+            Value::Bool(false) => true,
+            Value::Object(o) => o.values().all(known),
+            Value::Array(a) => a.iter().all(known),
+            _ => false,
+        }
+    }
+    require(known(&allowed_unknown), "unknown authorized effect")?;
+    let mut expected = before.clone();
+    expected["metadata"][0]["annotations"][ANNOTATION] = json!(m.after_revision);
+    let mut actual = after.clone();
+    for v in [&mut expected, &mut actual] {
+        let meta = v["metadata"][0]
+            .as_object_mut()
+            .ok_or_else(|| refuse("metadata shape"))?;
+        meta.remove("generation");
+        meta.remove("resource_version");
+    }
+    require(expected == actual, "effect exceeds one annotation")
+}
+
+/// Semantic validation for offline verification/tests. The protected `inspect`
+/// entry point additionally derives these bytes from the pinned binary plan.
+pub fn validate_inspection(
+    m: &Manifest,
+    config: &Value,
+    state: &Value,
+    raw: &[u8],
+) -> Result<Inspection> {
+    m.validate()?;
+    configuration(m, config)?;
+    require(raw.len() <= MAX_JSON, "inspection size")?;
+    let v = strict_value(raw)?;
+    require(
+        v["format_version"] == "1.2" && v["terraform_version"] == m.terraform_version,
+        "inspection version",
+    )?;
+    require(
+        closed(
+            &v,
+            &[
+                "format_version",
+                "terraform_version",
+                "planned_values",
+                "resource_changes",
+                "prior_state",
+                "configuration",
+                "timestamp",
+                "applyable",
+                "complete",
+                "errored",
+                "resource_drift",
+                "deferred_changes",
+                "output_changes",
+                "relevant_attributes",
+                "variables",
+                "checks",
+            ],
+        ),
+        "unsupported plan fields",
+    )?;
+    require(
+        v["applyable"] == true && v["complete"] == true && v["errored"] == false,
+        "incomplete or errored plan",
+    )?;
+    for key in [
+        "resource_drift",
+        "deferred_changes",
+        "output_changes",
+        "variables",
+        "checks",
+    ] {
+        require(empty(v.get(key)), "extra effects, inputs, drift or checks")?;
+    }
+    let change = one(&v["resource_changes"])?;
+    require(
+        change["address"] == ADDRESS
+            && change["mode"] == "managed"
+            && change["type"] == "kubernetes_config_map_v1"
+            && change["provider_name"] == PROVIDER
+            && change["change"]["actions"] == json!(["update"]),
+        "action is not one ConfigMap update",
+    )?;
+    require(
+        ["previous_address", "deposed", "index"]
+            .iter()
+            .all(|k| change.get(k).is_none())
+            && ["importing", "generated_config"]
+                .iter()
+                .all(|k| change["change"].get(k).is_none()),
+        "move/import/replacement",
+    )?;
+    let before = &change["change"]["before"];
+    let after = &change["change"]["after"];
+    values(m, before, after, &change["change"]["after_unknown"])?;
+    for (key, expected) in [("prior_state", before), ("planned_values", after)] {
+        let module = if key == "prior_state" {
+            &v[key]["values"]["root_module"]
+        } else {
+            &v[key]["root_module"]
+        };
+        require(empty(module.get("child_modules")), "child module")?;
+        let resource = one(&module["resources"])?;
+        require(
+            resource["address"] == ADDRESS
+                && resource["provider_name"] == PROVIDER
+                && resource["mode"] == "managed"
+                && resource["type"] == "kubernetes_config_map_v1"
+                && resource["schema_version"] == 0
+                && resource["values"] == *expected,
+            "inconsistent resource view",
+        )?;
+    }
+    let module = &v["configuration"]["root_module"];
+    require(empty(module.get("module_calls")), "module calls")?;
+    let configured = one(&module["resources"])?;
+    require(
+        configured["address"] == ADDRESS
+            && configured["mode"] == "managed"
+            && configured["type"] == "kubernetes_config_map_v1"
+            && configured["provider_config_key"] == "kubernetes"
+            && configured.get("provisioners").is_none(),
+        "executable configuration",
+    )?;
+    let mut expected_expressions = serde_json::Map::new();
+    for (key, value) in config["resource"]["kubernetes_config_map_v1"]["target"]
+        .as_object()
+        .unwrap()
+    {
+        let expression = if key == "metadata" {
+            let fields: serde_json::Map<String, Value> = value
+                .as_object()
+                .unwrap()
+                .iter()
+                .map(|(name, value)| (name.clone(), json!({"constant_value":value})))
+                .collect();
+            json!([fields])
+        } else {
+            json!({"constant_value":value})
+        };
+        expected_expressions.insert(key.clone(), expression);
+    }
+    require(
+        configured["expressions"] == Value::Object(expected_expressions),
+        "embedded resource differs from protected configuration",
+    )?;
+    let provider = &v["configuration"]["provider_config"]["kubernetes"];
+    require(
+        v["configuration"]["provider_config"]
+            .as_object()
+            .is_some_and(|p| p.len() == 1),
+        "additional provider configuration",
+    )?;
+    require(
+        provider["full_name"] == PROVIDER && provider["version_constraint"] == "2.38.0",
+        "inspection provider",
+    )?;
+    let expected_provider: serde_json::Map<String, Value> = config["provider"]["kubernetes"]
+        .as_object()
+        .unwrap()
+        .iter()
+        .map(|(key, value)| (key.clone(), json!({"constant_value":value})))
+        .collect();
+    require(
+        provider["expressions"] == Value::Object(expected_provider),
+        "embedded provider differs from protected configuration",
+    )?;
+    require(
+        state["version"] == 4
+            && state["terraform_version"] == m.terraform_version
+            && state["lineage"].as_str().is_some_and(identifier),
+        "state identity",
+    )?;
+    let serial = state["serial"]
+        .as_u64()
+        .ok_or_else(|| refuse("state serial"))?;
+    require(
+        serial <= 9_007_199_254_740_991 && empty(state.get("outputs")),
+        "state serial or outputs",
+    )?;
+    let stored = one(&state["resources"])?;
+    require(
+        stored["mode"] == "managed"
+            && stored["type"] == "kubernetes_config_map_v1"
+            && stored["name"] == "target"
+            && stored["provider"] == format!("provider[\"{PROVIDER}\"]")
+            && stored.get("module").is_none(),
+        "state resource",
+    )?;
+    let instance = one(&stored["instances"])?;
+    require(
+        instance["attributes"] == *before
+            && instance["schema_version"] == 0
+            && instance.get("index_key").is_none()
+            && instance.get("deposed").is_none(),
+        "state differs from plan baseline",
+    )?;
+    Ok(Inspection {
+        profile: m.profile.clone(),
+        status: "inspection_passed",
+        manifest_digest: digest("terraform-plan-manifest", &serde_json::to_value(m)?)?,
+        inspection_sha256: hash(raw),
+        inputs: m.files.clone(),
+        workspace_id: m.workspace_id.clone(),
+        backend: m.backend.clone(),
+        backend_state_path: m.backend_state_path.clone(),
+        state_lineage: state["lineage"].as_str().unwrap().into(),
+        state_serial: serial,
+        target: m.target.clone(),
+        effect_digest: digest(
+            "terraform-plan-effect",
+            &json!({"address":ADDRESS,"before":before,"after":after}),
+        )?,
+        guard_level: "Level_C",
+        execution_enabled: false,
+    })
+}
+
+#[cfg(unix)]
+pub(crate) struct Stage(PathBuf);
+#[cfg(unix)]
+impl Stage {
+    fn new() -> Result<Self> {
+        use std::os::unix::fs::DirBuilderExt;
+        let path = std::fs::canonicalize(std::env::temp_dir())?
+            .join(format!("kf-tf-inspect-{:032x}", rand::random::<u128>()));
+        std::fs::DirBuilder::new().mode(0o700).create(&path)?;
+        let stage = Self(path);
+        Root::open(&stage.0)?;
+        Ok(stage)
+    }
+    fn write(&self, name: &str, bytes: &[u8], executable: bool) -> Result<()> {
+        use std::{
+            io::Write,
+            os::unix::fs::{OpenOptionsExt, PermissionsExt},
+        };
+        let path = self.0.join(name);
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&path)?;
+        file.write_all(bytes)?;
+        if executable {
+            file.set_permissions(std::fs::Permissions::from_mode(0o700))?;
+        }
+        Ok(())
+    }
+    async fn command(&self, arguments: &[&str]) -> Result<Vec<u8>> {
+        self.command_with_token(arguments, None).await
+    }
+    pub(crate) async fn command_with_token(
+        &self,
+        arguments: &[&str],
+        token: Option<&str>,
+    ) -> Result<Vec<u8>> {
+        use std::{os::unix::process::CommandExt, process::Stdio};
+        use tokio::io::AsyncReadExt;
+        let mut command = tokio::process::Command::new(self.0.join("terraform"));
+        command
+            .args(arguments)
+            .current_dir(&self.0)
+            .env_clear()
+            .env("TF_DATA_DIR", self.0.join(".terraform"))
+            .env("TF_CLI_CONFIG_FILE", self.0.join("terraform.rc"))
+            .env("CHECKPOINT_DISABLE", "1")
+            .env("TF_IN_AUTOMATION", "1")
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .kill_on_drop(true);
+        command.as_std_mut().process_group(0);
+        // Terraform can create backend state and lock files. Set only the child
+        // mask; the syscall is async-signal-safe and touches no allocator/locks.
+        unsafe {
+            command.as_std_mut().pre_exec(|| {
+                rustix::process::umask(rustix::fs::Mode::from_bits_truncate(0o077));
+                Ok(())
+            });
+        }
+        if let Some(token) = token {
+            command.env("KUBE_TOKEN", token);
+        }
+        let mut child = command.spawn().map_err(|_| refuse("tool spawn"))?;
+        struct Group(rustix::process::Pid);
+        impl Drop for Group {
+            fn drop(&mut self) {
+                let _ = rustix::process::kill_process_group(self.0, rustix::process::Signal::KILL);
+            }
+        }
+        let _group = Group(rustix::process::Pid::from_raw(child.id().unwrap() as i32).unwrap());
+        let stdout = child.stdout.take().unwrap();
+        let stderr = child.stderr.take().unwrap();
+        async fn read<R: tokio::io::AsyncRead + Unpin>(stream: R, cap: usize) -> Result<Vec<u8>> {
+            let mut bytes = Vec::new();
+            stream.take(cap as u64 + 1).read_to_end(&mut bytes).await?;
+            require(bytes.len() <= cap, "tool output size")?;
+            Ok(bytes)
+        }
+        let (out, _err, status) = tokio::time::timeout(Duration::from_secs(20), async {
+            tokio::try_join!(read(stdout, MAX_JSON), read(stderr, 64 * 1024), async {
+                child.wait().await.map_err(Error::from)
+            })
+        })
+        .await
+        .map_err(|_| refuse("tool deadline"))??;
+        require(status.success(), "tool refused inspection")?;
+        Ok(out)
+    }
+}
+#[cfg(unix)]
+impl Drop for Stage {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Read pinned private blobs through descriptor-relative custody, copy them to
+/// an owned private directory, and derive JSON there without inherited secrets.
+/// Root and manifest belong to the protected planner, not the agent runtime.
+#[cfg(unix)]
+pub async fn inspect(root_path: &Path, manifest_path: &Path) -> Result<Inspection> {
+    Ok(prepare(root_path, manifest_path).await?.inspection)
+}
+
+#[cfg(unix)]
+pub struct Prepared {
+    pub inspection: Inspection,
+    pub manifest: Manifest,
+    pub(crate) config: Value,
+    pub(crate) state: Value,
+    pub(crate) stage: Stage,
+}
+#[cfg(unix)]
+pub async fn prepare(root_path: &Path, manifest_path: &Path) -> Result<Prepared> {
+    let root = Root::open(root_path)?;
+    let manifest = Manifest::decode(&root.read(manifest_path, Material::Secret, 64 * 1024)?)?;
+    let stage = Stage::new()?;
+    let provider_path = format!(
+        ".terraform/providers/{PROVIDER}/{}/{}/terraform-provider-kubernetes_v{}_x5",
+        manifest.provider_version, manifest.platform, manifest.provider_version
+    );
+    let destinations = [
+        "terraform",
+        &provider_path,
+        "plan.bin",
+        "terraform.tfstate",
+        ".terraform.lock.hcl",
+        "main.tf.json",
+    ];
+    let mut config = Value::Null;
+    let mut state = Value::Null;
+    for (name, destination) in FILES.iter().zip(destinations) {
+        let bound = match *name {
+            "terraform.bin" | "kubernetes.bin" => 128 << 20,
+            "plan.bin" => 16 << 20,
+            _ => MAX_JSON,
+        };
+        let bytes = root.read_snapshot(&root_path.join(name), bound)?;
+        require(
+            hash(&bytes) == manifest.files[*name],
+            "input digest mismatch",
+        )?;
+        if *name == "configuration.json" {
+            config = strict_value(&bytes)?;
+            configuration(&manifest, &config)?;
+        }
+        if *name == "state.json" {
+            state = strict_value(&bytes)?;
+        }
+        stage.write(
+            destination,
+            &bytes,
+            *name == "terraform.bin" || *name == "kubernetes.bin",
+        )?;
+    }
+    if manifest.profile == EXECUTION_PROFILE {
+        let bytes = root.read_snapshot(&root_path.join("backend.json"), MAX_JSON)?;
+        require(
+            hash(&bytes) == manifest.files["backend.json"],
+            "backend metadata digest",
+        )?;
+        let backend = strict_value(&bytes)?;
+        require(
+            backend["backend"]["type"] == "local"
+                && backend["backend"]["config"]["path"] == json!(manifest.backend_state_path)
+                && backend["backend"]["config"]["workspace_dir"].is_null(),
+            "native local backend identity",
+        )?;
+        stage.write(".terraform/terraform.tfstate", &bytes, false)?;
+    }
+    stage.write("terraform.rc", b"disable_checkpoint = true\n", false)?;
+    let version = strict_value(&stage.command(&["version", "-json"]).await?)?;
+    require(
+        version["terraform_version"] == manifest.terraform_version
+            && version["platform"] == manifest.platform,
+        "tool version/platform",
+    )?;
+    let raw = stage.command(&["show", "-json", "plan.bin"]).await?;
+    let inspection = validate_inspection(&manifest, &config, &state, &raw)?;
+    Ok(Prepared {
+        inspection,
+        manifest,
+        config,
+        state,
+        stage,
+    })
+}
+#[cfg(not(unix))]
+pub async fn inspect(_root_path: &Path, _manifest_path: &Path) -> Result<Inspection> {
+    Err(refuse("Unix custody required"))
+}
