diff --git a/crates/kedgeflow/src/bin/kf-terraform-apply.rs b/crates/kedgeflow/src/bin/kf-terraform-apply.rs
new file mode 100644
index 0000000..b6378d9
--- /dev/null
+++ b/crates/kedgeflow/src/bin/kf-terraform-apply.rs
@@ -0,0 +1,63 @@
+use clap::{Parser, Subcommand};
+use std::path::PathBuf;
+#[derive(Parser)]
+#[command(
+    version,
+    about = "Protected original-attempt Terraform apply and query; no automatic retries"
+)]
+struct Arguments {
+    #[arg(long)]
+    material_root: PathBuf,
+    #[arg(long)]
+    config: PathBuf,
+    #[command(subcommand)]
+    command: Command,
+}
+#[derive(Subcommand)]
+enum Command {
+    Execute {
+        #[arg(long)]
+        request: PathBuf,
+    },
+    Query {
+        #[arg(long)]
+        attempt_id: String,
+    },
+}
+#[cfg(unix)]
+async fn run() -> kedgeflow::error::Result<()> {
+    use kedgeflow::{
+        contracts::strict_value,
+        file_custody::{Material, Root},
+        terraform_apply::{Config, Request},
+    };
+    let args = Arguments::parse();
+    let runner = Config::load(&args.material_root, &args.config).await?;
+    let report = match args.command {
+        Command::Execute { request } => {
+            let root = Root::open(&args.material_root)?;
+            let value: Request = serde_json::from_value(strict_value(&root.read(
+                &request,
+                Material::Secret,
+                2 << 20,
+            )?)?)?;
+            runner.execute(&value).await?
+        }
+        Command::Query { attempt_id } => runner.status(&attempt_id).await?,
+    };
+    println!("{}", serde_json::to_string(&report)?);
+    Ok(())
+}
+#[tokio::main]
+async fn main() {
+    #[cfg(unix)]
+    if let Err(error) = run().await {
+        eprintln!("kf-terraform-apply: {error}");
+        std::process::exit(1);
+    }
+    #[cfg(not(unix))]
+    {
+        eprintln!("kf-terraform-apply: Unix custody required");
+        std::process::exit(1);
+    }
+}
