[Unit]
Description=KedgeFlow protected Terraform gateway
Documentation=https://github.com/openkedge/kedgeflow
Wants=network-online.target
After=network-online.target kedgeflow-governance.service kedgeflow-control.service kedgeflow-broker.service
PartOf=kedgeflow.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=kf-terraform-gateway
Group=kf-terraform-gateway
WorkingDirectory=/
StateDirectory=kedgeflow/terraform-gateway
StateDirectoryMode=0700
Environment=TMPDIR=/var/lib/kedgeflow/terraform-gateway
ReadOnlyPaths=/etc/kedgeflow/terraform-gateway
ReadWritePaths=/var/lib/kedgeflow/terraform-gateway
UMask=0077
ExecStartPre=/opt/kedgeflow-terraform/current/bin/kf-proxy --config /etc/kedgeflow/terraform-gateway/config.json --custody-root /etc/kedgeflow/terraform-gateway --require-managed --check
ExecStart=/opt/kedgeflow-terraform/current/bin/kf-proxy --config /etc/kedgeflow/terraform-gateway/config.json --custody-root /etc/kedgeflow/terraform-gateway --require-managed
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=5s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
Delegate=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kedgeflow-gateway

[Install]
WantedBy=kedgeflow.target
