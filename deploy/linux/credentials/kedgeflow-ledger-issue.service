[Unit]
Description=Authenticate and audit KedgeFlow ledger service principals
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=kf-credentials
Group=kf-credentials
WorkingDirectory=/
UMask=0077
ExecStart=/opt/kedgeflow/current/bin/kf-ledger-credentials --config /etc/kedgeflow/ledger-credentials/issuer.json --custody-root /etc/kedgeflow/ledger-credentials --issue
TimeoutStartSec=90s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/kedgeflow/ledger-credentials
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kedgeflow-ledger-issue
