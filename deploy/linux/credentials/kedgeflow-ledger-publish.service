[Unit]
Description=Install a freshly audited KedgeFlow ledger credential batch
Requires=kedgeflow-ledger-issue.service
After=kedgeflow-ledger-issue.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=kf-credentials
WorkingDirectory=/
UMask=0077
ExecStart=/usr/bin/python3 /opt/kedgeflow/current/libexec/kf-ledger-publish.py --config /etc/kedgeflow/ledger-credentials/mapping.json
TimeoutStartSec=15s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc/kedgeflow/gateway/credentials /etc/kedgeflow/control/credentials /etc/kedgeflow/broker/credentials /etc/kedgeflow/recovery/credentials /etc/kedgeflow/collector/credentials /etc/kedgeflow/operator/credentials /etc/kedgeflow/governance/credentials
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=16
LimitNOFILE=256
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kedgeflow-ledger-publish
