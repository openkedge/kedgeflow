[Unit]
Description=KedgeFlow control
Documentation=https://github.com/openkedge/kedgeflow
Wants=network-online.target
After=network-online.target
PartOf=kedgeflow.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=kf-control
Group=kf-control
WorkingDirectory=/
UMask=0077
ExecStartPre=/opt/kedgeflow/current/bin/kf-control --config /etc/kedgeflow/control/config.json --custody-root /etc/kedgeflow/control --require-managed --check
ExecStart=/opt/kedgeflow/current/bin/kf-control --config /etc/kedgeflow/control/config.json --custody-root /etc/kedgeflow/control --require-managed
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=40s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kedgeflow-control

[Install]
WantedBy=kedgeflow.target
