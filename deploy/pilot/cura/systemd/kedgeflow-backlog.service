[Unit]
Description=KedgeFlow cura backlog observation
Documentation=https://github.com/openkedge/kedgeflow
Wants=network-online.target
After=network-online.target kedgeflow-collector.service kedgeflow-sql-target.service
PartOf=kedgeflow-cura.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
StateDirectory=kedgeflow/telemetry
StateDirectoryMode=0755
ReadWritePaths=/var/lib/kedgeflow/telemetry
ExecStart=/usr/bin/python3 /opt/kedgeflow/current/libexec/kf-pilot-backlog.py --binary /opt/kedgeflow/current/bin/kf-supervise --config /etc/kedgeflow/recovery/config.json --custody-root /etc/kedgeflow/recovery --output /var/lib/kedgeflow/telemetry/backlog.prom
Type=oneshot
User=kf-recovery
Group=kf-recovery
WorkingDirectory=/
UMask=0077
TimeoutStartSec=60s
TimeoutStopSec=40s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kedgeflow-recovery

[Install]
