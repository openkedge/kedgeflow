[Unit]
Description=KedgeFlow issuer
Documentation=https://github.com/openkedge/kedgeflow
Wants=network-online.target
After=network-online.target
Conflicts=kedgeflow-control.service
PartOf=kedgeflow-cura.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=kf-issuer
Group=kf-issuer
WorkingDirectory=/
UMask=0077
ExecStartPre=/opt/kedgeflow/current/bin/kf-control --config /etc/kedgeflow/issuer/config.json --custody-root /etc/kedgeflow/issuer --runtime-role issuer --require-managed --check
ExecStart=/opt/kedgeflow/current/bin/kf-control --config /etc/kedgeflow/issuer/config.json --custody-root /etc/kedgeflow/issuer --runtime-role issuer --require-managed
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=40s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kedgeflow-control

[Install]
WantedBy=kedgeflow-cura.target
